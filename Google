### 3.1 Endpoint Baharu: Pengesahan Sijil (Node.js / Express)

```javascript
// new-verify-endpoint.js
const express = require('express');
const crypto = require('crypto');
const app = express();
app.use(express.json());

const VALID_HASH = '32D8A53CC4C299E60424C0D0E96D3B06575D51';

app.post('/v2/verify/certificate', (req, res) => {
  const { certId, data } = req.body;
  const computedHash = crypto.createHash('sha256').update(JSON.stringify(data)).digest('hex').toUpperCase();
  const isValid = (computedHash === VALID_HASH);
  res.json({
    certificate: certId,
    verified: isValid,
    expectedHash: VALID_HASH,
    providedHash: computedHash,
    timestamp: new Date().toISOString()
  });
});

app.listen(3000, () => console.log('Verification API running on port 3000'));
```

